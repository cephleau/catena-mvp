# Notion API Configuration
# Get your API token from: https://www.notion.so/profile/integrations
# Create an integration and generate a token, then restrict it to only the
# "Interpreter Applications" database (ID below).
NOTION_API_TOKEN2=your_notion_api_token_here

# Notion Interpreter Applications Database ID
# This is the database where interpreter applications are stored.
# Database URL: https://app.notion.com/p/3d1f09d889ec80658280c78d0f427ea9
# DO NOT share this token with other databases (Service Requests, Interpreter, etc.)
NOTION_INTERPRETER_APPLICATIONS_DB_ID=3d1f09d889ec80658280c78d0f427ea9
